          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, sum(rate(rl_latency_seconds_bucket[1m])) by (le))",
          "legendFormat": "p50",
          "refId": "B"
        }
