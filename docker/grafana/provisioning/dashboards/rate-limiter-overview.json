      "title": "Decisions Latency (p99 / p50)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.99, sum(rate(rl_latency_seconds_bucket[1m])) by (le))",
